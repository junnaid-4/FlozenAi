generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  type      String   // 'automation' | 'course'
  pricePkr  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Purchase {
  id              String   @id @default(cuid())
  userId          String
  productId       String
  productType     String
  stripeSessionId String   @unique
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  downloads       Download[]
}

model Download {
  id         String   @id @default(cuid())
  purchaseId String
  fileUrl    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}
